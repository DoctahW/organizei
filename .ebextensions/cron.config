files:
  "/etc/cron.d/tesouro-refresh":
    mode: "000644"
    owner: root
    group: root
    content: |
      0 13 * * * root export $(cat /opt/elasticbeanstalk/deployment/env | xargs) && . /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py refresh_tesouro_titles >> /var/log/tesouro_cron.log 2>&1

commands:
  remove_old_cron_backup:
    command: "rm -f /etc/cron.d/tesouro-refresh.bak"
    ignoreErrors: true
